WHICH="/usr/bin/which"
for util in cryptsetup ls cp mv ln mkdir mount cat grep echo awk head lsblk od chmod bash nohup sleep qvm-kill qvm-run poweroff chroot sync ldd xargs; do
  var="${util//-/_}"
