qubes.HostState.Set * @USB_VM@ @default allow target=@adminvm
qubes.LockScreen * @USB_VM@ sys-gui allow autostart=no
qubes.LockScreen * @USB_VM@ sys-gui-vnc allow autostart=no
qubes.LockScreen * @USB_VM@ sys-gui-gpu allow autostart=no
buskill.selfDestruct * @USB_VM@ dom0 allow
buskill.Disarm * sys-gui @USB_VM@ allow autostart=no
buskill.Disarm * sys-gui-vnc @USB_VM@ allow autostart=no
buskill.Disarm * sys-gui-gpu @USB_VM@ allow autostart=no
